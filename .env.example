# ==============================================
# Help My Travel - Environment Variables
# ==============================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpmytravel

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Google APIs
# Required for restaurant search and geocoding
GOOGLE_PLACES_API_KEY=
# Required for menu translation
GOOGLE_TRANSLATE_API_KEY=

# File Storage
# Options: "local" (dev) or "s3" (production)
STORAGE_TYPE=local
UPLOADS_DIR=./uploads

# S3 / Compatible Storage (when STORAGE_TYPE=s3)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT=

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@helpmytravel.com

# Application URLs
API_PORT=3001
ADMIN_URL=http://localhost:3000
APP_URL=exp://localhost:8081

# Admin panel
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
